{
  "openapi": "3.0.3",
  "info": {
    "title": "x-HanYun API",
    "description": "x-HanYun 是一个基于 GoZero 框架封装的开箱即用的 Web 项目模板",
    "version": "1.0.0",
    "contact": {
      "name": "CrossLang Studio",
      "url": "https://github.com/cross-lang/x-HanYun"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8888",
      "description": "本地开发环境"
    },
    {
      "url": "http://your-production-server.com",
      "description": "生产环境"
    }
  ],
  "tags": [
    {
      "name": "oplog",
      "description": "操作日志相关接口"
    },
    {
      "name": "adminuser",
      "description": "管理员用户相关接口"
    }
  ],
  "paths": {
    "/v1/api/oplog/create": {
      "post": {
        "tags": ["oplog"],
        "summary": "创建操作日志",
        "description": "创建一条新的操作日志记录",
        "operationId": "createOpLog",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOpLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOpLogResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/api/adminser/create": {
      "post": {
        "tags": ["adminuser"],
        "summary": "创建管理员用户",
        "description": "创建一个新的管理员用户",
        "operationId": "createAdminUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAdminUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OpLog": {
        "type": "object",
        "properties": {
          "admin_uid": {
            "type": "string",
            "description": "管理员用户ID",
            "example": "admin001"
          },
          "audit_type": {
            "type": "integer",
            "format": "int64",
            "description": "审计类型",
            "example": 1
          },
          "op_time": {
            "type": "integer",
            "format": "int64",
            "description": "操作时间（时间戳）",
            "example": 1640995200
          },
          "op_dip": {
            "type": "string",
            "description": "操作IP地址",
            "example": "192.168.1.1"
          },
          "op_dname": {
            "type": "string",
            "description": "操作设备名称",
            "example": "PC-001"
          }
        }
      },
      "CreateOpLogRequest": {
        "type": "object",
        "properties": {
          "admin_uid": {
            "type": "string",
            "description": "管理员用户ID",
            "example": "admin001"
          },
          "audit_type": {
            "type": "integer",
            "format": "int64",
            "description": "审计类型",
            "example": 1
          },
          "op_time": {
            "type": "integer",
            "format": "int64",
            "description": "操作时间（时间戳）",
            "example": 1640995200
          },
          "op_dip": {
            "type": "string",
            "description": "操作IP地址",
            "example": "192.168.1.1"
          },
          "op_dname": {
            "type": "string",
            "description": "操作设备名称",
            "example": "PC-001"
          }
        }
      },
      "CreateOpLogResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "操作日志ID",
            "example": 1
          }
        }
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "admin_uid": {
            "type": "string",
            "description": "管理员用户ID",
            "example": "admin001"
          },
          "audit_type": {
            "type": "integer",
            "format": "int64",
            "description": "审计类型",
            "example": 1
          },
          "op_time": {
            "type": "integer",
            "format": "int64",
            "description": "操作时间（时间戳）",
            "example": 1640995200
          },
          "op_dip": {
            "type": "string",
            "description": "操作IP地址",
            "example": "192.168.1.1"
          },
          "op_dname": {
            "type": "string",
            "description": "操作设备名称",
            "example": "PC-001"
          }
        }
      },
      "CreateAdminUserRequest": {
        "type": "object",
        "properties": {
          "admin_uid": {
            "type": "string",
            "description": "管理员用户ID",
            "example": "admin001"
          },
          "audit_type": {
            "type": "integer",
            "format": "int64",
            "description": "审计类型",
            "example": 1
          },
          "op_time": {
            "type": "integer",
            "format": "int64",
            "description": "操作时间（时间戳）",
            "example": 1640995200
          },
          "op_dip": {
            "type": "string",
            "description": "操作IP地址",
            "example": "192.168.1.1"
          },
          "op_dname": {
            "type": "string",
            "description": "操作设备名称",
            "example": "PC-001"
          }
        }
      },
      "CreateAdminUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "管理员用户ID",
            "example": 1
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "错误码",
            "example": -1
          },
          "msg": {
            "type": "string",
            "description": "错误信息",
            "example": "系统内部错误"
          },
          "debug": {
            "type": "string",
            "description": "调试信息",
            "example": "traceId:abc123, error:database connection failed"
          }
        }
      },
      "RespBase": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "响应码",
            "example": 0
          },
          "msg": {
            "type": "string",
            "description": "响应消息",
            "example": "success"
          }
        }
      },
      "EmptyReq": {
        "type": "object",
        "description": "空请求体"
      },
      "EmptyResp": {
        "type": "object",
        "description": "空响应体",
        "allOf": [
          {
            "$ref": "#/components/schemas/RespBase"
          }
        ]
      }
    }
  }
}
